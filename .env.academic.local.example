# Loads actual federation remotes while running the academic local stack.
VITE_REMOTE_SOURCE=federation
VITE_FEDERATED_REMOTES=academicManagementMfe
# Usa GET /api/v1/auth/me contra IAM local. El proxy de Vite dirige /auth a 8001.
VITE_SESSION_SOURCE=http
VITE_LOCAL_SESSION=true
# Notification-service no forma parte de esta practica del dominio academico.
VITE_NOTIFICATION_SOURCE=mock
